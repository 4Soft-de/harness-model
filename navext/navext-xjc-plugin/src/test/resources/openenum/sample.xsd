<?xml version="1.0" encoding="UTF-8"?>
<!--
    The schema used for code generation. Its open enumerations (DocumentType, BoltSize, Unused and
    Undefined) declare no enumeration facets, which is exactly why XJC maps them to String. The
    literals live in sample-strict.xsd.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="http://www.4soft.de/xjc-plugins/openenum/tests"
           targetNamespace="http://www.4soft.de/xjc-plugins/openenum/tests"
           elementFormDefault="qualified">

    <xs:element name="Root" type="t:Document"/>

    <xs:complexType name="Document">
        <xs:sequence>
            <!-- open, single valued -->
            <xs:element name="DocumentType" type="t:DocumentType" minOccurs="0"/>
            <!-- open, repeating -->
            <xs:element name="BoltSize" type="t:BoltSize" minOccurs="0" maxOccurs="unbounded"/>
            <!-- open, but without any literal in either schema -->
            <xs:element name="Undefined" type="t:Undefined" minOccurs="0"/>
            <!-- closed: must be left alone by the plugin -->
            <xs:element name="Anchor" type="t:AnchorType" minOccurs="0"/>
            <!-- a plain string: must be left alone by the plugin -->
            <xs:element name="Title" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="DocumentType">
        <xs:annotation>
            <xs:documentation xml:lang="en"><![CDATA[<p>The type of a document.</p>]]></xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="BoltSize">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <!-- Declared but never used by any element. -->
    <xs:simpleType name="Unused">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <!-- Has no literals in either schema, so no literal types must be generated for it. -->
    <xs:simpleType name="Undefined">
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="AnchorType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="FromStartNode"/>
            <xs:enumeration value="FromEndNode"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
