<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://maven.apache.org/POM/4.0.0"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.foursoft.harness</groupId>
        <artifactId>harness-parent</artifactId>
        <version>6.2.1-SNAPSHOT</version>
    </parent>

    <artifactId>coverage-report</artifactId>
    <packaging>pom</packaging>
    <name>Coverage Report</name>
    <description>
        Build-only module that aggregates the JaCoCo coverage of all modules, so that tests in one module
        are credited for the code they exercise in another one. It is never deployed or released.
    </description>

    <properties>
        <!-- Never publish this module. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <gpg.skip>true</gpg.skip>
        <!-- Nothing to analyse here; the aggregate report is consumed by the other modules. -->
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.foursoft.harness.navext</groupId>
            <artifactId>navext-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.navext</groupId>
            <artifactId>navext-xjc-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.kbl</groupId>
            <artifactId>kbl-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.kbl</groupId>
            <artifactId>kbl-v24</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.kbl</groupId>
            <artifactId>kbl-v25</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec</groupId>
            <artifactId>vec-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec</groupId>
            <artifactId>vec-v113</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec</groupId>
            <artifactId>vec-v12x</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec</groupId>
            <artifactId>vec-v2x</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec</groupId>
            <artifactId>vec-scripting-experimental</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.compatibility</groupId>
            <artifactId>compatibility-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.compatibility</groupId>
            <artifactId>compatibility-vec-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.compatibility</groupId>
            <artifactId>compatibility-vec11to12</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.compatibility</groupId>
            <artifactId>compatibility-vec12to20</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec.rdf</groupId>
            <artifactId>vec-rdf-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec.rdf</groupId>
            <artifactId>vec-rdf-changes-experimental</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.vec.rdf</groupId>
            <artifactId>vec-rdf-converter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.foursoft.harness.kbl2vec</groupId>
            <artifactId>kbl2vec</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
